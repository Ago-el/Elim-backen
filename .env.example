ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://postgres:YOUR_SUPABASE_DB_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_32_PLUS_CHARS
JWT_EXP_MINUTES=60
CORS_ORIGINS=https://YOUR-ADMIN-DOMAIN,https://YOUR-APP-DOMAIN
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=elim-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRY_SECONDS=900
MAX_UPLOAD_SIZE_MB=512
